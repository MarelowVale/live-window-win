{
  "name": "live-window-win",
  "productName": "实况窗 Live Window",
  "version": "1.6.0",
  "description": "仿 iOS 27 Liquid Glass 的 Windows 实况窗：鼠标触碰屏幕顶端自动下拉，可拖拽/隐藏到顶部，内置灵动岛式 Search or Ask、实况活动卡片与 iOS 通知中心。",
  "main": "main.js",
  "author": "Ethan Yang",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.4.14",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "marked": "^18.0.11"
  },
  "build": {
    "appId": "com.workbuddy.livewindow",
    "productName": "实况窗 Live Window",
    "asar": true,
    "compression": "normal",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "实况窗-Portable-${version}-${arch}.${ext}"
    }
  }
}
